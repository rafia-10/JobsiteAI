# Rendered at container start by nginx's entrypoint (envsubst). Only defined
# environment variables are substituted, so nginx runtime vars ($host, $uri,
# $backend, ...) pass through untouched:
#   ${BACKEND_URL} full base URL of the API
#                  (docker compose: http://backend:8000 · Render: https://…onrender.com)
#   ${RESOLVER}    container DNS server (set by docker-entrypoint.sh)
#   ${PORT}        listen port (compose: 80 · Render sets PORT=10000)
server {
    listen ${PORT};

    # Re-resolve the backend on every request so a changed upstream IP (e.g.
    # a Render hostname re-pointed at new instances) never needs an nginx restart.
    resolver ${RESOLVER} valid=30s ipv6=off;
    set $backend "${BACKEND_URL}";

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Variable proxy_pass passes the original request URI unchanged.
        proxy_pass $backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        # https backends need SNI (ignored for plain http, e.g. docker compose).
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 25m;
        # Server-Sent Events (/api/agent/stream) must not be buffered,
        # or streamed answers arrive in one lump.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri /index.html;
    }
}
