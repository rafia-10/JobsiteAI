# PreCode environment template — copy to .env
# --- Database (defaults work out of the box) ---
POSTGRES_USER=precode
POSTGRES_PASSWORD=precode_dev
POSTGRES_DB=precode

# --- LLM (required for the interactive agent). Any OpenAI-compatible API works.
#     Groq (fast, tool-calling): https://console.groq.com  model: openai/gpt-oss-120b
#     OpenAI: LLM_BASE_URL=https://api.openai.com/v1  model: gpt-4o-mini
OPENAI_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Server-side voice (Groq/OpenAI-compatible; optional).
#     STT: whisper-large-v3-turbo works out of the box.
#     TTS: canopylabs/orpheus-v1-english needs one-time terms acceptance in the
#     Groq console (console.groq.com -> that model). Until then the UI falls
#     back to the browser's built-in speech synthesis automatically.
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=tara
