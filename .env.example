# PreCode environment template — copy to .env
# --- Database (defaults work out of the box) ---
POSTGRES_USER=precode
POSTGRES_PASSWORD=precode_dev
POSTGRES_DB=precode

# --- LLM (optional for the PoC: without a key the agent falls back to a
#     deterministic heuristic answerer. Any OpenAI-compatible API works.)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Voice (server-side STT/TTS, OpenAI-compatible; optional).
#     The UI uses the browser's built-in speech recognition/synthesis by
#     default, so voice works even with these unset.
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
